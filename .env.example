# Carerix OAuth2 Credentials
# Get these from Carerix → Identity Access → Clients
CARERIX_CLIENT_ID=your-client-id-here
CARERIX_CLIENT_SECRET=your-client-secret-here
CARERIX_TOKEN_ENDPOINT=https://yourcompany.carerix.com/cxoauth2/token

# Server configuration (optional)
PORT=3000
CACHE_TTL_SECONDS=3600

# ─── Address panel (address-panel/README.md) ────────────────────────────────
# Address sources, searched together: pdok (NL, free), photon (Europe, free),
# google (needs key), demo (sample data, no internet needed)
ADDRESS_PROVIDERS=pdok,photon
# Optional: only show these countries, e.g. nl,be,de (empty = all of Europe)
ADDRESS_COUNTRIES=
# Optional: your own Photon server for heavy use
PHOTON_URL=https://photon.komoot.io
# Only when ADDRESS_PROVIDERS contains google
GOOGLE_MAPS_API_KEY=
GOOGLE_LANGUAGE_CODE=nl

# Shared secret the panel URL must carry (?key=...). Strongly recommended.
PANEL_ACCESS_KEY=

# Saving to Carerix uses the GraphQL API with the OAuth client above
# (CARERIX_CLIENT_ID / CARERIX_CLIENT_SECRET / CARERIX_TOKEN_ENDPOINT).
# Saving is only live with ADDRESS_DRY_RUN=false; otherwise the panel shows
# the mutation it would send.
CARERIX_GRAPHQL_URL=https://api.carerix.io/graphql/v1/graphql
ADDRESS_DRY_RUN=true

# Country ISO code → Carerix country data node id, e.g. {"NL":1234,"BE":1235}
COUNTRY_NODE_IDS=
# Optional: override the field mapping in lib/targets.js
ADDRESS_TARGETS_JSON=
# Which sites may embed the panel (standalone server; Vercel uses vercel.json)
PANEL_FRAME_ANCESTORS='self' https://*.carerix.com https://*.carerix.net
