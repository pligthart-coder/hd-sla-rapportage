# Carerix OAuth2 Credentials
# Get these from Carerix → Identity Access → Clients
CARERIX_CLIENT_ID=your-client-id-here
CARERIX_CLIENT_SECRET=your-client-secret-here
CARERIX_TOKEN_ENDPOINT=https://yourcompany.carerix.com/cxoauth2/token

# Server configuration (optional)
PORT=3000
CACHE_TTL_SECONDS=3600
